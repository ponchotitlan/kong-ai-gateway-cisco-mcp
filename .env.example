# Konnect Personal Access Token (used by the konnect/ scripts)
PAT=kpat_xxx

# Written automatically by konnect/create-ai-gateway.sh
AI_GATEWAY_ID=<ai-gateway-id>
AI_KONNECT_CLUSTER_CONTROL_PLANE=<control-plane-id>.control-plane.<region>.cloud.konghq.com:443
AI_KONNECT_CLUSTER_SERVER_NAME=<control-plane-id>.control-plane.<region>.cloud.konghq.com
AI_KONNECT_CLUSTER_TELEMETRY_ENDPOINT=<control-plane-id>.telemetry.<region>.cloud.konghq.com:443
AI_KONNECT_CLUSTER_TELEMETRY_SERVER_NAME=<control-plane-id>.telemetry.<region>.cloud.konghq.com
